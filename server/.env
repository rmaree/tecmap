# GTFS cache server configuration

# server port (by default 3000)
PORT=3000

# the real-time API end-point, using https://data.belgianmobility.io/  see their docs
KK="XXXXXXXXXXXXXXX"
RT_VEHICLE_API_URL='https://api-management-opendata-production.azure-api.net/api/gtfs/feed/tec/rt/vehicle-position/?format=protobuf'
